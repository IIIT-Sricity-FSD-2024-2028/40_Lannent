# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Nothing here is loaded automatically by Nest — dotenv is imported as the very
# first line of main.ts, because JWT_SECRET is read at module load.

# ── Required in production, generated per-process in development ────────────
# Signs the bearer tokens. Anyone holding it can mint a token for any user, so
# it must differ per environment and never be committed. At least 32 chars;
# the app refuses to boot in production without it.
#   generate with: openssl rand -hex 48
JWT_SECRET=

# How long an issued token stays valid. Default 12h.
JWT_EXPIRES_IN=12h

# ── Environment ─────────────────────────────────────────────────────────────
# development | test | production
# POST /seed/reset destroys every record and every uploaded file, and runs only
# where this says the data is disposable. Unset means refused.
NODE_ENV=development

# ── Network ─────────────────────────────────────────────────────────────────
PORT=3000

# Comma-separated origins allowed to call the API from a browser.
# REQUIRED in production — the app will not boot without it.
# In development any localhost / 127.0.0.1 / [::1] port is accepted regardless,
# so the frontend can run on whatever port you like.
# A page opened straight from disk (file://) sends Origin "null" and cannot be
# allowed — serve the frontend over http.
CORS_ORIGIN=

# Hops to trust for the client IP behind a load balancer. Rate limits count per
# IP, so without this everyone behind a proxy shares one budget. Leave unset
# unless there really is a proxy: trusting a forwarded header nobody sets lets
# a caller spoof their address and escape the limit.
TRUST_PROXY=

# ── Limits ──────────────────────────────────────────────────────────────────
# Global ceiling per IP per minute. A blunt backstop, not the real control —
# login, signup and the public upload carry their own stricter per-route limits.
RATE_LIMIT_PER_MIN=2000

# ── Email (forgot password) ─────────────────────────────────────────────────
# Reset links are sent over SMTP. Only SMTP_USER and SMTP_PASS are required;
# the rest default to Gmail (smtp.gmail.com, port 465, TLS).
#
# For Gmail, SMTP_PASS is an App Password — not your account password:
#   1. turn on 2-Step Verification for the Google account
#   2. https://myaccount.google.com/apppasswords → create one → paste the 16 letters
# Without these, "Forgot password" answers that email is not set up.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=Lannent <you@gmail.com>

# The seeded demo accounts (client@gmail.com, worker@gmail.com …) are real
# inboxes that belong to strangers, so their reset emails are delivered here
# instead, marked with the account they are for. Left empty, demo accounts
# get no email at all. Accounts people sign up with always get their own.
DEMO_MAIL_TO=

# Where the emailed reset link points — the React app.
# 5173 for `npm run dev`; 3000 when the built app is served by this server.
APP_URL=http://localhost:5173

# ── Transitional ────────────────────────────────────────────────────────────
# Set to 1 to let the old `role` / `user-id` headers identify a caller when no
# bearer token is present. Off by default and unavailable in production: with
# it on, anyone can send `role: superuser` and be believed.
AUTH_HEADER_FALLBACK=
